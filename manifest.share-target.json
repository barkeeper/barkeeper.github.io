{
  "//": "Fragment to MERGE into public/manifest.webmanifest (owned by the PWA work). Receiver: public/share-target-sw.js (importScripts it from the service worker). Consumer: src/shell/shell-ux.ts consumeLaunchFiles().",
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*", "audio/*", "text/plain", ".srt", ".vtt", ".txt"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/*": [".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".avif"],
        "video/*": [".mp4", ".webm", ".mov", ".mkv", ".m4v"],
        "audio/*": [".wav", ".mp3", ".ogg", ".flac", ".m4a"],
        "text/plain": [".txt", ".srt", ".vtt"]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  }
}
